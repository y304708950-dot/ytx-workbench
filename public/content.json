{
  "version": 1,
  "childName": "小朋友",
  "theme": "幼小衔接学习桌面",
  "sections": [
    {
      "id": "pinyin",
      "title": "拼音乐园",
      "icon": "🔤",
      "color": "#d8ecff",
      "lessons": [
        {
          "id": "pinyin-initials",
          "title": "声母小火车",
          "icon": "🚂",
          "type": "pinyin",
          "objective": "认识 b p m f d t n l 这些常见声母。",
          "cards": [
            {"big": "b", "title": "声母 b", "image": "🧸", "hint": "像广播开头的轻短声，不拖长。", "mouth": "双唇先闭住，再轻轻打开。", "say": "b"},
            {"big": "p", "title": "声母 p", "image": "🍑", "hint": "像吹出一口小气。", "mouth": "双唇闭住后送出气流。", "say": "p"},
            {"big": "m", "title": "声母 m", "image": "🐴", "hint": "嘴巴闭着，声音从鼻子出来。", "mouth": "双唇闭合，鼻腔轻轻振动。", "say": "m"},
            {"big": "f", "title": "声母 f", "image": "🍚", "hint": "上牙轻碰下唇。", "mouth": "牙齿轻碰下嘴唇，送出细气。", "say": "f"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "听家长读“b”，选出对应的声母。", "answer": "b", "options": ["b", "p", "m", "f"], "tip": "b 的嘴巴先闭住再打开。"},
            {"kind": "choice", "prompt": "哪个声母发音时要送出明显气流？", "answer": "p", "options": ["b", "p", "m", "l"], "tip": "p 像轻轻吹蜡烛。"}
          ]
        },
        {
          "id": "pinyin-finals",
          "title": "韵母花园",
          "icon": "🌼",
          "type": "pinyin",
          "objective": "认识 a o e i u ü，并观察口型变化。",
          "cards": [
            {"big": "a", "title": "张大嘴 a", "image": "😮", "hint": "嘴巴张大，声音响亮。", "mouth": "嘴张大，舌头放平。", "say": "a"},
            {"big": "o", "title": "圆圆嘴 o", "image": "⭕", "hint": "嘴唇收圆。", "mouth": "嘴唇像小圆圈。", "say": "o"},
            {"big": "e", "title": "扁扁嘴 e", "image": "鹅", "hint": "嘴角向两边展开。", "mouth": "嘴巴半开，嘴角微微向两边。", "say": "e"},
            {"big": "ü", "title": "小鱼嘴 ü", "image": "🐟", "hint": "像吹口哨的小圆嘴。", "mouth": "嘴唇撮圆，舌头靠前。", "say": "ü"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "发 a 时，嘴巴应该怎样？", "answer": "张大", "options": ["张大", "闭紧", "咬住下唇", "鼓起腮"], "tip": "a 是最开的大嘴音。"},
            {"kind": "choice", "prompt": "小鱼嘴是哪一个韵母？", "answer": "ü", "options": ["u", "ü", "e", "o"], "tip": "ü 的上面有两点。"}
          ]
        },
        {
          "id": "pinyin-whole",
          "title": "整体认读家族",
          "icon": "🏠",
          "type": "pinyin",
          "objective": "直接认读 zhi chi shi ri zi ci si yi wu yu。",
          "cards": [
            {"big": "zhi", "title": "整体认读 zhi", "image": "🍊", "hint": "整体读，不拆开拼。", "mouth": "舌尖翘起，声音短而清楚。", "say": "zhi"},
            {"big": "chi", "title": "整体认读 chi", "image": "🥄", "hint": "比 zhi 多一点送气。", "mouth": "舌尖翘起，送出气。", "say": "chi"},
            {"big": "shi", "title": "整体认读 shi", "image": "🦁", "hint": "像“狮”的读音。", "mouth": "舌尖翘起，气流从舌面过。", "say": "shi"},
            {"big": "yu", "title": "整体认读 yu", "image": "🐟", "hint": "小 ü 见到 y，去掉两点还读 ü。", "mouth": "嘴唇撮圆。", "say": "yu"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "哪个是整体认读音节？", "answer": "shi", "options": ["shi", "sh", "ia", "uo"], "tip": "shi 可以直接读出来。"},
            {"kind": "choice", "prompt": "yu 读起来像哪个韵母？", "answer": "ü", "options": ["u", "ü", "a", "o"], "tip": "yu 是小鱼嘴。"}
          ]
        },
        {
          "id": "pinyin-tones",
          "title": "声调滑梯",
          "icon": "🛝",
          "type": "pinyin",
          "objective": "感受一声平、二声扬、三声拐弯、四声降。",
          "cards": [
            {"big": "mā", "title": "一声", "image": "➖", "hint": "声音平平地走。", "mouth": "音高保持平稳。", "say": "mā"},
            {"big": "má", "title": "二声", "image": "↗️", "hint": "声音往上爬。", "mouth": "从低到高。", "say": "má"},
            {"big": "mǎ", "title": "三声", "image": "〰️", "hint": "先低再上，像小弯钩。", "mouth": "声音拐个弯。", "say": "mǎ"},
            {"big": "mà", "title": "四声", "image": "↘️", "hint": "声音往下落。", "mouth": "短促下降。", "say": "mà"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“mǎ”是第几声？", "answer": "三声", "options": ["一声", "二声", "三声", "四声"], "tip": "三声有一个小弯钩。"},
            {"kind": "choice", "prompt": "哪个声调像上坡？", "answer": "二声", "options": ["一声", "二声", "三声", "四声"], "tip": "二声从低往高走。"}
          ]
        },
        {
          "id": "pinyin-ba",
          "title": "b 加 a",
          "icon": "🍌",
          "type": "pinyin",
          "objective": "练习 b + a = ba 的拼读过程。",
          "cards": [
            {"big": "b + a = ba", "title": "两拼音节 ba", "image": "👄", "hint": "声母轻短，韵母响亮，连起来读 ba。", "mouth": "先闭唇发 b，再张大嘴接 a。", "say": "ba"},
            {"big": "bā bá bǎ bà", "title": "ba 的四声", "image": "🎵", "hint": "同一个 ba，声调不同意思会变。", "mouth": "保持 ba 的口型，改变声调。", "say": "bā bá bǎ bà"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "b + a 拼成什么？", "answer": "ba", "options": ["ba", "pa", "ma", "fa"], "tip": "先 b 后 a，连起来。"},
            {"kind": "choice", "prompt": "“爸爸”的第一个音节常读作？", "answer": "bà", "options": ["bā", "bá", "bǎ", "bà"], "tip": "爸爸的爸是四声。"}
          ]
        },
        {
          "id": "pinyin-ma",
          "title": "m 加 a",
          "icon": "🐴",
          "type": "pinyin",
          "objective": "练习 m + a = ma，并区分妈、麻、马、骂。",
          "cards": [
            {"big": "m + a = ma", "title": "两拼音节 ma", "image": "👩", "hint": "m 从鼻子轻轻发声，再接大嘴 a。", "mouth": "双唇闭住发 m，再张大嘴。", "say": "ma"},
            {"big": "mā má mǎ mà", "title": "ma 的四声", "image": "🐎", "hint": "mǎ 可以想到小马。", "mouth": "读 mǎ 时声音先下再上。", "say": "mā má mǎ mà"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“马”的拼音是哪一个？", "answer": "mǎ", "options": ["mā", "má", "mǎ", "mà"], "tip": "马是三声。"},
            {"kind": "choice", "prompt": "m + a 拼成什么？", "answer": "ma", "options": ["ma", "mi", "mo", "mu"], "tip": "韵母是 a。"}
          ]
        },
        {
          "id": "pinyin-shi",
          "title": "shi 小狮子",
          "icon": "🦁",
          "type": "pinyin",
          "objective": "直接认读 shi，并练习四声。",
          "cards": [
            {"big": "shi", "title": "整体认读 shi", "image": "🦁", "hint": "看到 shi 直接读，不拆。", "mouth": "舌尖微翘，牙齿留小缝。", "say": "shi"},
            {"big": "shī shí shǐ shì", "title": "shi 的四声", "image": "📖", "hint": "石头的石读 shí，事情的是读 shì。", "mouth": "同一口型，不同声调。", "say": "shī shí shǐ shì"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“石头”的“石”读作？", "answer": "shí", "options": ["shī", "shí", "shǐ", "shì"], "tip": "石是二声。"},
            {"kind": "choice", "prompt": "看到 shi 应该怎样读？", "answer": "整体读", "options": ["整体读", "拆成 s+h+i", "只读 i", "不发声"], "tip": "shi 是整体认读音节。"}
          ]
        },
        {
          "id": "pinyin-review",
          "title": "拼读小复习",
          "icon": "🎒",
          "type": "pinyin",
          "objective": "把声母、韵母和声调放在一起练习。",
          "cards": [
            {"big": "p + o = po", "title": "po", "image": "🥣", "hint": "p 要送气，o 要圆嘴。", "mouth": "先喷气，再圆嘴。", "say": "po"},
            {"big": "l + u = lu", "title": "lu", "image": "🦌", "hint": "l 舌尖轻碰上牙龈，u 圆嘴。", "mouth": "舌尖一弹，嘴唇收圆。", "say": "lu"},
            {"big": "n + ü = nü", "title": "nü", "image": "👧", "hint": "n 后面的小鱼嘴 ü 两点不能丢。", "mouth": "舌尖抵上牙龈，再撮圆嘴。", "say": "nü"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "p + o 拼成？", "answer": "po", "options": ["po", "bo", "pa", "pu"], "tip": "韵母是圆嘴 o。"},
            {"kind": "choice", "prompt": "哪个音节保留 ü 的两点？", "answer": "nü", "options": ["nu", "nü", "yu", "wu"], "tip": "n 和 ü 在一起，两点还在。"}
          ]
        }
      ]
    },
    {
      "id": "hanzi",
      "title": "汉字启蒙",
      "icon": "🈶",
      "color": "#fff0b8",
      "lessons": [
        {
          "id": "hanzi-sun-moon",
          "title": "日月水火",
          "icon": "☀️",
          "type": "hanzi",
          "objective": "用图像联想认识日、月、水、火。",
          "cards": [
            {"big": "日", "title": "太阳的日", "image": "☀️", "hint": "像一扇装着太阳的小窗。", "steps": ["竖", "横折", "横", "横"], "say": "日"},
            {"big": "月", "title": "月亮的月", "image": "🌙", "hint": "像弯弯月亮慢慢变成字。", "steps": ["撇", "横折钩", "横", "横"], "say": "月"},
            {"big": "水", "title": "水滴的水", "image": "💧", "hint": "中间像水流，两边像水花。", "steps": ["竖钩", "横撇", "撇", "捺"], "say": "水"},
            {"big": "火", "title": "火苗的火", "image": "🔥", "hint": "两点像小火星。", "steps": ["点", "撇", "撇", "捺"], "say": "火"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "看到 ☀️，应该选哪个字？", "answer": "日", "options": ["日", "月", "水", "火"], "tip": "太阳和日有关。"},
            {"kind": "match", "prompt": "把汉字和图片配对。", "pairs": [{"left": "日", "right": "☀️"}, {"left": "月", "right": "🌙"}, {"left": "水", "right": "💧"}, {"left": "火", "right": "🔥"}]}
          ]
        },
        {
          "id": "hanzi-nature",
          "title": "山木田土",
          "icon": "⛰️",
          "type": "hanzi",
          "objective": "认识自然里的山、木、田、土。",
          "cards": [
            {"big": "山", "title": "高高的山", "image": "⛰️", "hint": "三个竖像山峰。", "steps": ["竖", "竖折", "竖"], "say": "山"},
            {"big": "木", "title": "树木的木", "image": "🌳", "hint": "一横是树冠，一竖是树干。", "steps": ["横", "竖", "撇", "捺"], "say": "木"},
            {"big": "田", "title": "田地的田", "image": "🟫", "hint": "像被分成四块的田。", "steps": ["竖", "横折", "横", "竖", "横"], "say": "田"},
            {"big": "土", "title": "泥土的土", "image": "🌱", "hint": "下面一横长，像大地。", "steps": ["横", "竖", "横"], "say": "土"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“木”可以想到什么？", "answer": "树", "options": ["树", "月亮", "水杯", "火苗"], "tip": "木就是树木。"},
            {"kind": "choice", "prompt": "哪个字像三座山峰？", "answer": "山", "options": ["山", "田", "土", "木"], "tip": "山有三个竖。"}
          ]
        },
        {
          "id": "hanzi-body",
          "title": "人口手目",
          "icon": "🖐️",
          "type": "hanzi",
          "objective": "认识身体和人的常用汉字。",
          "cards": [
            {"big": "人", "title": "人的人", "image": "🧍", "hint": "像一个人分开两条腿站着。", "steps": ["撇", "捺"], "say": "人"},
            {"big": "口", "title": "嘴巴的口", "image": "👄", "hint": "像张开的嘴。", "steps": ["竖", "横折", "横"], "say": "口"},
            {"big": "手", "title": "小手的手", "image": "🖐️", "hint": "笔画像手指和手掌。", "steps": ["撇", "横", "横", "竖钩"], "say": "手"},
            {"big": "目", "title": "眼睛的目", "image": "👀", "hint": "比日多一横，像眼睛里的线。", "steps": ["竖", "横折", "横", "横", "横"], "say": "目"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "看到 👄，选哪个字？", "answer": "口", "options": ["口", "目", "手", "人"], "tip": "口就是嘴巴。"},
            {"kind": "match", "prompt": "把身体字和图片配对。", "pairs": [{"left": "手", "right": "🖐️"}, {"left": "目", "right": "👀"}, {"left": "口", "right": "👄"}, {"left": "人", "right": "🧍"}]}
          ]
        },
        {
          "id": "hanzi-strokes",
          "title": "笔画小队",
          "icon": "✏️",
          "type": "hanzi",
          "objective": "认识横、竖、撇、捺、点。",
          "cards": [
            {"big": "一", "title": "横", "image": "➡️", "hint": "从左到右，稳稳写过去。", "steps": ["起笔", "行笔", "收笔"], "say": "横"},
            {"big": "丨", "title": "竖", "image": "⬇️", "hint": "从上到下，像站直的小树。", "steps": ["起笔", "向下", "收笔"], "say": "竖"},
            {"big": "丿", "title": "撇", "image": "↙️", "hint": "从右上向左下轻轻撇。", "steps": ["重起", "轻收"], "say": "撇"},
            {"big": "丶", "title": "点", "image": "💧", "hint": "像一滴小雨点。", "steps": ["轻按", "收住"], "say": "点"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“一”是什么笔画？", "answer": "横", "options": ["横", "竖", "撇", "点"], "tip": "平平的一笔是横。"},
            {"kind": "choice", "prompt": "“丶”像什么？", "answer": "小雨点", "options": ["小雨点", "小山", "树干", "太阳"], "tip": "点短短的，像水滴。"}
          ]
        },
        {
          "id": "hanzi-radicals",
          "title": "偏旁朋友",
          "icon": "🧩",
          "type": "hanzi",
          "objective": "认识三点水、木字旁、口字旁、提手旁。",
          "cards": [
            {"big": "氵", "title": "三点水", "image": "💧", "hint": "常和水有关：河、海、洗。", "steps": ["点", "点", "提"], "say": "三点水"},
            {"big": "木", "title": "木字旁", "image": "🌳", "hint": "常和树木有关：林、桃、桥。", "steps": ["横", "竖", "撇", "点"], "say": "木字旁"},
            {"big": "口", "title": "口字旁", "image": "👄", "hint": "常和嘴巴说话有关：唱、吃、叫。", "steps": ["竖", "横折", "横"], "say": "口字旁"},
            {"big": "扌", "title": "提手旁", "image": "🖐️", "hint": "常和手的动作有关：打、拍、拉。", "steps": ["横", "竖钩", "提"], "say": "提手旁"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "“河”里有哪个偏旁？", "answer": "氵", "options": ["氵", "木", "口", "扌"], "tip": "河和水有关。"},
            {"kind": "choice", "prompt": "“拍”可能和什么有关？", "answer": "手", "options": ["手", "水", "树", "嘴"], "tip": "提手旁常表示手的动作。"}
          ]
        },
        {
          "id": "hanzi-picture",
          "title": "看图识字",
          "icon": "🖼️",
          "type": "hanzi",
          "objective": "从图片联想到汉字和意思。",
          "cards": [
            {"big": "云", "title": "白云的云", "image": "☁️", "hint": "天空里轻轻飘。", "steps": ["横", "横", "撇折", "点"], "say": "云"},
            {"big": "雨", "title": "下雨的雨", "image": "🌧️", "hint": "里面四点像雨滴。", "steps": ["横", "竖", "横折钩", "竖", "点", "点", "点", "点"], "say": "雨"},
            {"big": "鸟", "title": "小鸟的鸟", "image": "🐦", "hint": "有头、有身子、有尾巴。", "steps": ["撇", "横折钩", "点", "竖折折钩", "横"], "say": "鸟"},
            {"big": "虫", "title": "小虫的虫", "image": "🐛", "hint": "小虫爬呀爬。", "steps": ["竖", "横折", "横", "竖", "提", "点"], "say": "虫"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "🌧️ 对应哪个字？", "answer": "雨", "options": ["云", "雨", "鸟", "虫"], "tip": "雨里面有雨点。"},
            {"kind": "choice", "prompt": "哪个字和 🐦 有关？", "answer": "鸟", "options": ["鸟", "虫", "云", "田"], "tip": "小鸟会飞。"}
          ]
        },
        {
          "id": "hanzi-match",
          "title": "汉字配对",
          "icon": "🔗",
          "type": "hanzi",
          "objective": "把汉字、图片、词语放在一起理解。",
          "cards": [
            {"big": "大", "title": "大小的大", "image": "👐", "hint": "张开手臂像一个大字。", "steps": ["横", "撇", "捺"], "say": "大"},
            {"big": "小", "title": "大小的小", "image": "🤏", "hint": "中间一竖，两边小点。", "steps": ["竖钩", "撇", "点"], "say": "小"},
            {"big": "上", "title": "上面的上", "image": "⬆️", "hint": "竖在横的上面。", "steps": ["竖", "横", "横"], "say": "上"},
            {"big": "下", "title": "下面的下", "image": "⬇️", "hint": "点在横的下面。", "steps": ["横", "竖", "点"], "say": "下"}
          ],
          "exercises": [
            {"kind": "choice", "prompt": "哪个字表示“上面”？", "answer": "上", "options": ["上", "下", "大", "小"], "tip": "箭头向上。"},
            {"kind": "match", "prompt": "把意思和汉字配对。", "pairs": [{"left": "大", "right": "👐"}, {"left": "小", "right": "🤏"}, {"left": "上", "right": "⬆️"}, {"left": "下", "right": "⬇️"}]}
          ]
        },
        {
          "id": "hanzi-life",
          "title": "生活常见字",
          "icon": "🏫",
          "type": "hanzi",
